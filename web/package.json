{
  "name": "auditdesk-web",
  "version": "2.2.0-dev.0",
  "private": true,
  "description": "AuditDesk Vue 3 local-first audit workbench",
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-ocr-assets.mjs && node scripts/sync-paddle-assets.mjs",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/sync-ocr-assets.mjs && node scripts/sync-paddle-assets.mjs",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "validate:tools": "node scripts/validate-tools.mjs",
    "validate:accounting": "node scripts/validate-accounting.mjs",
    "validate:ocr-quality": "node scripts/validate-ocr-quality.mjs",
    "validate:profit-journal": "node scripts/validate-profit-journal.mjs",
    "validate:ocr-pipeline": "node scripts/validate-ocr-pipeline.mjs",
    "validate:model-assets": "node scripts/validate-model-assets.mjs",
    "validate:router": "node scripts/validate-router.mjs",
    "validate:markdown": "node scripts/validate-markdown.mjs",
    "validate:showcase": "node scripts/validate-showcase.mjs",
    "validate:deck": "node scripts/validate-deck.mjs",
    "validate:typography": "node scripts/migrate-typography.mjs",
    "validate:encoding": "node scripts/fix-bom.mjs",
    "validate:all": "npm run validate:tools && npm run validate:accounting && npm run validate:profit-journal && npm run validate:model-assets && npm run validate:router && npm run validate:ocr-pipeline && npm run validate:ocr-quality && npm run validate:markdown && npm run validate:showcase && npm run validate:deck && npm run validate:typography && npm run validate:encoding",
    "sync:ocr": "node scripts/sync-ocr-assets.mjs",
    "sync:paddle": "node scripts/sync-paddle-assets.mjs",
    "make:brand": "node scripts/make-brand-assets.mjs",
    "export:pages": "node scripts/export-pages.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@paddleocr/paddleocr-js": "^0.4.2",
    "element-plus": "^2.14.6",
    "tesseract.js": "^7.0.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "vite": "^8.3.1"
  }
}
