# 依赖
node_modules/

# 构建产物（可由 npm run web:build / web:export 重新生成）
web/dist/
github-pages/
AuditDesk-GitHub-Pages.zip

# Electron 打包产物（约 1.4 GB）
release/

# OCR 运行时与语言模型的本地副本（约 17.6 MB）。
# 它们是 node_modules/tesseract.js* 与 resources/vendor/ocr 的拷贝，
# 由 `npm run sync:ocr`（predev / prebuild / CI 会自动执行）生成，
# 因此不入库，避免仓库体积翻倍。真正的模型源文件在 resources/vendor/ocr/。
#
# 例外：PaddleOCR 的 PP-OCRv5 模型（20.55 MB）**入库**。
# 原因：它只能从外部 CDN（paddle-model-ecology.bj.bcebos.com）拉取，
# 而 GitHub Actions runner 拉不到时会导致 prebuild 失败、整站不更新
# （2026-09-26 实际发生过一次）。入库后 CI 不再依赖任何外部模型源。
web/public/ocr/*
!web/public/ocr/paddle/

# 日志与临时文件
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.vscode/
.idea/
*.tmp

# 备份目录里的压缩包与解压目录内容重复，只保留解压目录
backups/**/*.zip

# OCR 准确率基准的工作目录（约 34 MB：测试图 + 备选模型）。
# 用 `node web/scripts/bench-ocr.mjs --make-images` 重新生成，不入库。
web/.bench-ocr/

# 浏览器端真机验证用的临时图片
web/public/_t/
web/public/A-scan.png
web/public/D-photo.png
